{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "edu-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-29",
    "workers_dev": false,
    "preview_urls": false,
    "upload_source_maps": true,
    "observability": { "enabled": true },
    "vars": {
        "ENVIRONMENT": "development",
        "CORS_ORIGINS": "http://localhost:3000",
        "AUTH_ENABLED": "false",
        "AUTH_ISSUER": "",
        "AUTH_AUDIENCE": "",
        "AUTH_JWKS_URL": "",
        "MAX_UPLOAD_BYTES": "5242880",
        "REALTIME_TICKET_TTL_SECONDS": "30",
        "OUTBOX_RETENTION_DAYS": "30",
        "PROCESSED_JOBS_RETENTION_DAYS": "0",
    },
    // Local resources work without an account. Deploy may provision cloud resources.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "edu-db",
            "migrations_dir": "drizzle",
        },
    ],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "edu-files" }],
    "queues": {
        "producers": [{ "binding": "JOBS", "queue": "edu-jobs" }],
        "consumers": [
            {
                "queue": "edu-jobs",
                "max_batch_size": 10,
                "max_batch_timeout": 5,
                "max_retries": 5,
                "retry_delay": 60,
                "max_concurrency": 2,
                "dead_letter_queue": "edu-jobs-dlq",
            },
            {
                "queue": "edu-jobs-dlq",
                "max_batch_size": 10,
                "max_retries": 100,
                "retry_delay": 300,
                "max_concurrency": 1,
            },
        ],
    },
    "durable_objects": {
        "bindings": [{ "name": "REALTIME", "class_name": "RealtimeRoom" }],
    },
    "exports": {
        "RealtimeRoom": { "type": "durable-object", "storage": "sqlite" },
    },
    "ratelimits": [
        {
            "name": "API_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 120, "period": 60 },
        },
    ],
    // Infrastructure outbox dispatch and expired-ticket cleanup. UTC.
    "triggers": { "crons": ["* * * * *"] },
}
